{
  "name": "d3-drag",
  "version": "3.0.0",
  "description": "Drag and drop SVG, HTML or Canvas using mouse or touch input.",
  "homepage": "https://d3js.org/d3-drag/",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3/d3-drag.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "drag",
    "behavior",
    "interaction"
  ],
  "license": "ISC",
  "author": {
    "name": "Mike Bostock",
    "url": "https://bost.ocks.org/mike"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "module": "dist/d3-drag.mjs",
  "main": "dist/d3-drag.mjs",
  "jsdelivr": "dist/d3-drag.min.js",
  "unpkg": "dist/d3-drag.min.js",
  "exports": {
    "umd": "./dist/d3-drag.min.js",
    "default": "./dist/d3-drag.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "d3-dispatch": "1 - 3",
    "d3-selection": "3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "rollup": "^4.67.4",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "test": "vitest",
    "lint": "eslint src test",
    "prepublishOnly": "rm -rf dist && rollup -c"
  },
  "engines": {
    "node": ">=12"
  }
}
